{
  "expo": {
    "name": "锦囊",
    "slug": "dsh-palm",
    "version": "0.2.3",
    "runtimeVersion": "0.2.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dshpalm",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0D10",
    "updates": {
      "url": "https://u.expo.dev/ad6383fb-4e39-4086-b79a-789f22d84eba",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cool.cnb.dshpalm"
    },
    "android": {
      "package": "cool.cnb.dshpalm",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#141C31"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "ad6383fb-4e39-4086-b79a-789f22d84eba"
      }
    },
    "owner": "npcdyc"
  }
}
