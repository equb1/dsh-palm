{
  "name": "dsh-palm-workspace",
  "private": true,
  "version": "0.0.1",
  "description": "dsh-palm / 锦囊 — 手机上的 DSH 宿主（MVP 脚手架）",
  "scripts": {
    "engine": "tsx engine/src/main.ts",
    "app": "npm --prefix app run start",
    "app:web": "npm --prefix app run web",
    "test": "node --import tsx --test test/*.test.ts",
    "stream:replay": "node --import tsx scripts/stream-replay.ts",
    "bench:light": "node --import tsx scripts/bench-light.ts",
    "device:regression": "node --import tsx scripts/device-regression.ts",
    "release:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-preflight.ps1",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test",
    "plugin:check": "node --import tsx scripts/plugin-compat.ts",
    "plugin:data": "node scripts/plugin-data.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "multicast-dns": "^7.2.5"
  }
}
